<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_crema">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- LOGO / ICONO -->
            <ImageView
                android:id="@+id/imgLogoLogin"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:src="@drawable/ic_streetbite_logo"
                android:contentDescription="Logo StreetBite"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="56dp" />

            <!-- TITULO -->
            <TextView
                android:id="@+id/txtStreetBite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StreetBite"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/sb_marron"
                android:letterSpacing="0.01"
                app:layout_constraintTop_toBottomOf="@id/imgLogoLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp" />

            <!-- SUBTITULO -->
            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comida callejera, al instante"
                android:textSize="15sp"
                android:textColor="@color/sb_texto_suave"
                app:layout_constraintTop_toBottomOf="@id/txtStreetBite"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp" />

            <!-- TARJETA DE LOGIN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/txtDescripcion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iniciar sesión"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/sb_marron" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingresa con tu correo para continuar"
                        android:textSize="13sp"
                        android:textColor="@color/sb_texto_suave"
                        android:layout_marginTop="4dp" />

                    <!-- CORREO -->
                    <EditText
                        android:id="@+id/edtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_sb_input"
                        android:hint="Correo electrónico"
                        android:inputType="textEmailAddress"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textSize="15sp"
                        android:textColor="@color/sb_marron"
                        android:textColorHint="@color/sb_texto_suave" />

                    <!-- CONTRASEÑA -->
                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_sb_input"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textSize="15sp"
                        android:textColor="@color/sb_marron"
                        android:textColorHint="@color/sb_texto_suave" />

                    <!-- OLVIDASTE -->
                    <TextView
                        android:id="@+id/txtOlvidaste"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/sb_naranja"
                        android:layout_marginTop="10dp" />

                    <!-- BOTÓN LOGIN -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Iniciar sesión"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:backgroundTint="@color/sb_marron" />

                    <!-- SEPARADOR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/sb_borde" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="o"
                            android:textColor="@color/sb_texto_suave"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/sb_borde" />
                    </LinearLayout>

                    <!-- DISCORD -->
                    <Button
                        android:id="@+id/btnDiscord"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="14dp"
                        android:text="Continuar con Discord"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_sb_boton_discord" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- REGISTRO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/cardLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtNoCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes una cuenta?"
                    android:textSize="14sp"
                    android:textColor="@color/sb_texto_suave" />

                <TextView
                    android:id="@+id/txtRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Regístrate"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/sb_naranja" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>