<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tarjeta_borde"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- FILA SUPERIOR: LOGO + DATOS DEL FOODTRUCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgFavoritoLogo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_image"
                android:clipToOutline="true"
                android:contentDescription="@string/foodtruck_imagen"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:src="@drawable/tacos" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFavoritoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/sb_marron"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Las Mechadas de Mechita" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtFavoritoRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/sb_marron"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_star"
                        app:drawableTint="@color/sb_ambar"
                        tools:text="5.0" />

                    <TextView
                        android:id="@+id/txtFavoritoEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_abierto"
                        android:drawablePadding="5dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/sb_verde"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_dot"
                        app:drawableTint="@color/sb_verde"
                        tools:text="Abierto" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFavoritoEtiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_naranja"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/sb_naranja_oscuro"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_tag"
                    app:drawableTint="@color/sb_naranja_oscuro"
                    tools:text="Bajón nocturno" />
            </LinearLayout>
        </LinearLayout>

        <!-- NOTA PERSONAL -->
        <TextView
            android:id="@+id/txtFavoritoNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_info_pill"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/sb_marron"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_note"
            app:drawableTint="@color/sb_texto_suave"
            tools:text="Pedir la mechada italiana sin mayo" />

        <!-- DIVISOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/sb_divisor" />

        <!-- ACCIONES CRUD: EDITAR Y QUITAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnEditarFavorito"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Editar nota"
                android:textColor="@color/sb_naranja"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_edit"
                app:drawableTint="@color/sb_naranja" />

            <TextView
                android:id="@+id/btnQuitarFavorito"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Quitar"
                android:textColor="@color/sb_rojo"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_delete"
                app:drawableTint="@color/sb_rojo" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
