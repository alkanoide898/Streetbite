<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_crema"
    android:orientation="vertical">

    <!-- CABECERA NOCTURNA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cabecera_nocturna"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolverFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="14dp"
                android:text="Volver"
                android:textColor="@color/sb_texto_suave"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_arrow_back"
                app:drawableTint="@color/sb_texto_suave" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAgregarFavorito"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_boton_primario"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="14dp"
                android:paddingBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Agregar"
                android:textAllCaps="false"
                android:textColor="@color/sb_texto_sobre_acento"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_add"
                app:drawableTint="@color/sb_texto_sobre_acento" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="Mis favoritos"
            android:textColor="@color/sb_marron"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/txtResumenFavoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tus foodtrucks guardados con notas personales"
            android:textColor="@color/sb_texto_suave"
            android:textSize="14sp" />

        <!-- CHIPS DE FILTRO POR ETIQUETA -->
        <HorizontalScrollView
            android:id="@+id/scrollEtiquetasFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenedorChipsEtiquetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- ESTADO CARGANDO -->
    <LinearLayout
        android:id="@+id/vistaCargandoFavoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateTint="@color/sb_naranja" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cargando tus favoritos..."
            android:textColor="@color/sb_texto_suave"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ESTADO VACÍO -->
    <LinearLayout
        android:id="@+id/vistaVaciaFavoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_borde"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="26dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circulo_icono">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/sb_naranja" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtTituloVacioFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Todavía no tienes favoritos"
                android:textColor="@color/sb_marron"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloVacioFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Guarda tus foodtrucks preferidos de San Carlos con una etiqueta y tus notas personales."
                android:textColor="@color/sb_texto_suave"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAgregarFavoritoVacio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_boton_primario"
                android:stateListAnimator="@null"
                android:text="Agregar mi primer favorito"
                android:textAllCaps="false"
                android:textColor="@color/sb_texto_sobre_acento"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- LISTA DE FAVORITOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp" />

</LinearLayout>
