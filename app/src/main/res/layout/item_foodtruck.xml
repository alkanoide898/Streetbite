<?xml version="1.0" encoding="utf-8"?>
<!-- Ítem de la lista vertical "Foodtrucks cerca de ti". -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgFoodtruck"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:background="@drawable/bg_image"
            android:clipToOutline="true"
            android:contentDescription="@string/foodtruck_imagen"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            android:src="@drawable/tacos" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/txtNombreFoodtruck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sb_marron"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Taco Truck" />

            <TextView
                android:id="@+id/txtDescripcionFoodtruck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sb_texto_suave"
                android:textSize="13sp"
                tools:text="Tacos y comida mexicana" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRatingFoodtruck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sb_marron"
                    android:textSize="13sp"
                    tools:text="⭐ 4,8" />

                <TextView
                    android:id="@+id/txtDistanciaFoodtruck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/sb_marron"
                    android:textSize="13sp"
                    tools:text="📍 0,8 km" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEstadoFoodtruck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="● Abierto" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
