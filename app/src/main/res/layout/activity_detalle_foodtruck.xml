<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_crema"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CABECERA CON EL LOGO DEL LOCAL -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="292dp"
                android:background="@drawable/bg_hero_logo">

                <androidx.cardview.widget.CardView
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_centerInParent="true"
                    app:cardBackgroundColor="#FFFFFBF5"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/imgDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Logo del local"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tacos" />

                </androidx.cardview.widget.CardView>

                <!-- BOTÓN VOLVER -->
                <TextView
                    android:id="@+id/btnVolverDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_volver_detalle"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:text="Volver"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_arrow_back"
                    app:drawableTint="@android:color/white" />

                <!-- BOTÓN FAVORITO -->
                <TextView
                    android:id="@+id/btnFavoritoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_volver_detalle"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="Guardar"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_heart_outline"
                    app:drawableTint="@android:color/white" />

            </RelativeLayout>

            <!-- TARJETA DE INFORMACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-32dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tarjeta_borde"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtNombreDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="Nombre Foodtruck"
                    android:textColor="@color/sb_marron"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/txtDescripcionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Descripción del foodtruck"
                    android:textColor="@color/sb_texto_suave"
                    android:textSize="14sp" />

                <!-- FILA DE INFO (ADAPTABLE A PANTALLAS PEQUEÑAS) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtRatingDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_info_pill"
                            android:drawablePadding="5dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="4.8"
                            android:textColor="@color/sb_marron"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_star"
                            app:drawableTint="@color/sb_ambar" />

                        <TextView
                            android:id="@+id/txtDistanciaDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_info_pill"
                            android:drawablePadding="5dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="0.8 km"
                            android:textColor="@color/sb_marron"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/sb_texto_suave" />

                        <TextView
                            android:id="@+id/txtEstadoDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_abierto"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="Abierto"
                            android:textColor="@color/sb_verde"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_dot"
                            app:drawableTint="@color/sb_verde" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/sb_divisor" />

                <!-- INFORMACIÓN Y CONTACTO -->
                <TextView
                    android:id="@+id/txtDireccionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/sb_texto"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/sb_texto_suave"
                    tools:text="Av. O'Higgins 123"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtHorarioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/sb_texto_suave"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_clock"
                    app:drawableTint="@color/sb_texto_suave"
                    tools:text="12:00 - 22:00"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtTelefonoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/sb_naranja"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_phone"
                    app:drawableTint="@color/sb_naranja"
                    tools:text="+56 9 9687 3838"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtInstagramDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/sb_naranja"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_instagram"
                    app:drawableTint="@color/sb_naranja"
                    tools:text="@local"
                    tools:visibility="visible" />

                <!-- BOTÓN CÓMO LLEGAR -->
                <Button
                    android:id="@+id/btnComoLlegarDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_boton_primario"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="Cómo llegar"
                    android:textAllCaps="false"
                    android:textColor="@color/sb_texto_sobre_acento"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_directions"
                    app:drawableTint="@color/sb_texto_sobre_acento" />

                <!-- RESUMEN DE FAVORITO PERSONAL -->
                <LinearLayout
                    android:id="@+id/bloqueFavoritoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_info_pill"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtEtiquetaFavoritoDetalle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/sb_naranja_oscuro"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_tag"
                            app:drawableTint="@color/sb_naranja_oscuro"
                            tools:text="En tus favoritos · Bajón nocturno" />

                        <TextView
                            android:id="@+id/btnEditarFavoritoDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="4dp"
                            android:text="Editar"
                            android:textColor="@color/sb_naranja"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCompartidoFavoritoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/sb_naranja"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_group"
                        app:drawableTint="@color/sb_naranja"
                        tools:text="En conjunto con Carlos" />

                    <TextView
                        android:id="@+id/txtNotaFavoritoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/sb_marron"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_note"
                        app:drawableTint="@color/sb_texto_suave"
                        tools:text="Pedir la mechada sin mayo" />
                </LinearLayout>

            </LinearLayout>

            <!-- MENÚ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="Menú"
                android:textColor="@color/sb_marron"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="28dp" />

            <TextView
                android:id="@+id/txtMenuVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_tarjeta_borde"
                android:gravity="center"
                android:padding="20dp"
                android:text="Todavía no hay fotos del menú disponibles."
                android:textColor="@color/sb_texto_suave"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
