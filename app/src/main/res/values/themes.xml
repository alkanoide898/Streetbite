<resources>
    <style name="Theme.StreetBite" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/sb_naranja</item>
        <item name="colorPrimaryDark">@color/sb_crema</item>
        <item name="colorAccent">@color/sb_naranja</item>
        <item name="android:windowBackground">@color/sb_crema</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Transición compartida de la foto al abrir el detalle -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <!-- Visor de fotos del menú: fondo negro a pantalla completa -->
    <style name="Theme.StreetBite.Foto" parent="Theme.StreetBite">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash del sistema: mismo fondo que activity_splash.xml para que no se note el salto -->
    <style name="Theme.StreetBite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#181818</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.StreetBite</item>
    </style>
</resources>
