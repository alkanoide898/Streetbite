<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#E06620"
                android:startColor="#F47B35" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sb_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/sb_borde" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>
